# Play Point Systems / Play Amplified environment-variable contract.
# Never commit real secret values. Production values belong in Vercel.

# Public application URL used for absolute redirects / checkout return URLs.
NEXT_PUBLIC_APP_URL=

# Play Point Live / multiplayer Supabase runtime.
# Preferred Play Point-specific names:
PLAY_POINT_LIVE_SUPABASE_URL=
PLAY_POINT_LIVE_SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe Supabase values when client auth/realtime is needed:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibility fallback accepted by some server code:
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated signing secret for Play Point game/account sessions.
# If omitted, server code can fall back to the Supabase service-role key, but a
# separate high-entropy secret is preferred in production.
PLAY_POINT_GAMES_SESSION_SECRET=

# Stripe. Keep secret keys server-only.
STRIPE_SECRET_KEY=
STRIPE_QUICK_SCORE_PRO_PRICE_ID=

# Contact form delivery. Verify the sender domain in Resend before production use.
RESEND_API_KEY=
CONTACT_TO_EMAIL=channing@playpointsystems.com
CONTACT_FROM_EMAIL=Play Point Systems <contact@playpointsystems.com>

# Optional database storage for contact and support submissions.
# Configure one of these connection strings, not all three.
PLAY_POINT_LIVE_DATABASE_URL=
# Remote connections verify TLS certificates by default. Use disable only for localhost.
# PLAY_POINT_LIVE_DATABASE_SSL=require
# Optional PEM CA certificate; use literal \n characters in single-line deployment values.
# PLAY_POINT_LIVE_DATABASE_CA_CERT=
# SUPABASE_DB_URL=
# DATABASE_URL=

# Optional Cloudflare Turnstile protection. Configure both values together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
