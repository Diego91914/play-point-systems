# Contact form delivery. Verify the sender domain in Resend before production use.
RESEND_API_KEY=
CONTACT_TO_EMAIL=channing@playpointsystems.com
CONTACT_FROM_EMAIL=Play Point Systems <contact@playpointsystems.com>

# Optional database storage for contact and support submissions.
# Configure one of these connection strings, not all three.
PLAY_POINT_LIVE_DATABASE_URL=
# SUPABASE_DB_URL=
# DATABASE_URL=

# Optional Cloudflare Turnstile protection. Configure both values together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
